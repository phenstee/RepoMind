# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local-only development credentials used by docker-compose.yml. Override in real deployments.
DATABASE_URL=postgresql+psycopg://repomind:repomind@localhost:5432/repomind

# API only: set to an existing absolute directory containing your trusted repositories.
# Do not use a drive root or a home directory; choose a dedicated workspace.
# REPOMIND_WORKSPACE_ROOT=/absolute/path/to/workspaces

# Reserved for later milestones.
REDIS_URL=redis://localhost:6379/0
