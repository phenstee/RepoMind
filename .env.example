# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local-only development credentials used by docker-compose.yml. The Compose ports bind only
# to 127.0.0.1; override these credentials in any other deployment model.
DATABASE_URL=postgresql+psycopg://repomind:repomind@localhost:5432/repomind

# API only: set to an existing absolute directory containing your trusted repositories.
# Do not use a drive root or a home directory; choose a dedicated workspace.
# REPOMIND_WORKSPACE_ROOT=/absolute/path/to/workspaces

# JSON list of local browser origins permitted to call the API. Never use "*".
# REPOMIND_TRUSTED_FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Reserved for later milestones.
REDIS_URL=redis://localhost:6379/0

# Durable worker coordination. PostgreSQL remains the authoritative job store.
JOB_LEASE_SECONDS=300
JOB_POLL_SECONDS=1
