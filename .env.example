# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional tuning for OpenAI chat and embedding requests (defaults shown): per-request
# timeout in seconds (> 0) and RepoMind's retry attempts for transient failures (>= 0).
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3

# Local-only development credentials used by docker-compose.yml. The Compose ports bind only
# to 127.0.0.1; override these credentials in any other deployment model. This is also the
# database Alembic migrates (alembic.ini deliberately has no sqlalchemy.url).
DATABASE_URL=postgresql+psycopg://repomind:repomind@localhost:5432/repomind

# API only: set to an existing absolute directory containing your trusted repositories.
# Do not use a drive root or a home directory; choose a dedicated workspace.
# REPOMIND_WORKSPACE_ROOT=/absolute/path/to/workspaces

# JSON list of local browser origins permitted to call the API. Never use "*".
# REPOMIND_TRUSTED_FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# JSON list of Host header names the API answers to (DNS-rebinding protection); other hosts are
# rejected. Explicit names only: no wildcards or ports. Default shown.
# REPOMIND_ALLOWED_HOSTS=["localhost","127.0.0.1","api","[::1]"]

# Job coordination: worker wake-ups and live job-progress fan-out (Pub/Sub). Best effort only;
# if Redis is unavailable, jobs stay queued in PostgreSQL and workers fall back to polling.
REDIS_URL=redis://localhost:6379/0

# Durable worker coordination. PostgreSQL remains the authoritative job store.
# JOB_LEASE_SECONDS must be within 30-3600; JOB_POLL_SECONDS within 0.1-60.
JOB_LEASE_SECONDS=300
JOB_POLL_SECONDS=1
# A job whose lease expires this many times (e.g. it keeps crashing its worker) is failed
# instead of requeued again (1-100).
# JOB_MAX_ATTEMPTS=3
